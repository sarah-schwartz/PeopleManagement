@model ErrorViewModel
@{
    ViewData["Title"] = "שגיאה";
}

<div class="container-lg py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <h1 class="h3 text-danger mb-3">אירעה שגיאה</h1>
                    <p class="text-muted mb-4">לא הצלחנו להשלים את הבקשה. אפשר לחזור לרשימת האנשים ולנסות שוב.</p>

                    @if (Model.ShowRequestId)
                    {
                        <p class="mb-4">
                            <strong>מזהה בקשה:</strong>
                            <code>@Model.RequestId</code>
                        </p>
                    }

                    <a asp-controller="People" asp-action="Index" class="btn btn-primary">חזרה לרשימת האנשים</a>
                </div>
            </div>
        </div>
    </div>
</div>
