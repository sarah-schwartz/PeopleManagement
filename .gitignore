## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET publish output
publish/
artifacts/

# Visual Studio cache/options
.vs/
.vscode/
.idea/

# Rider
*.sln.iml

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Entity Framework
*.mdf
*.ldf

# App settings / secrets
appsettings.Development.json
secrets.json
*.pfx
*.publishsettings

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Node modules (for React/Frontend inside solution)
node_modules/
dist/
build/

# Coverage reports
coverage/
*.coverage
*.coveragexml

# Docker
docker-compose.override.yml

# Azure / deployment
.publish/
*.azurePubxml

# Resharper
_ReSharper*/
*.DotSettings.user

# SQL Server files
*.dbmdl

# Backup & temp files
*.bak
*.tmp
*.temp
*.cache

# Generated files
Generated_Code/

# IIS Express
iisexpress/

# Local DB
*.db
*.sqlite
*.sqlite3

# Package managers
.paket/
paket-files/

# JetBrains
.idea/

# Mac/Linux
*.swp
*.swo
*~

# Environment variables
.env
.env.*

